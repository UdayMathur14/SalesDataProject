@{
    Layout = null;
}
@{
    ViewData["Title"] = "Login";
}
@model SalesDataProject.Models.AuthenticationModels.User

@if (TempData["Message"] != null)
{
    <div class="alert-message @(TempData["MessageType"] == "Error" ? "error" : "success")" id="alertMessage" role="alert">
        <p>@TempData["Message"]</p>
        <button class="close-btn" onclick="closeAlertMessage()">×</button>
    </div>
}

<div class="full-page-bg">

    <div class="center-login-card">

        <div class="avatar-logo-circle">
            <img src="~/images/EnnobleNewLogo.jpg" alt="Ennoble IP Logo" class="avatar-img" />
        </div>

        <form asp-action="Login" method="post" class="login-form">

            <div class="input-container">
                <span class="icon">✉</span>
                <input type="text" asp-for="Username" placeholder="Email ID" class="form-input" required />
            </div>

            <div class="input-container">
                <span class="icon">🔒</span>
                <input type="password" asp-for="Password" placeholder="Password" class="form-input" required />
            </div>
@* 
            <div class="options-container">
                <label class="remember-me">
                    <input type="checkbox" /> Remember me
                </label>
                <a href="#" class="forgot-pwd">Forgot Password?</a>
            </div> *@

            <button class="signin-btn" type="submit">LOGIN</button>
        </form>
    </div>
</div>

<style>
    /* Pure screen par background image set karne ke liye */
    .full-page-bg {
        position: fixed;
        top: 0;
        left: 0; 
        min-width:100vw ;
        height: 100vh;
        background: url('/images/Login Page Design.jpeg') no-repeat center center;
        background-size: cover;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Bilkul center mein transparent glass card */
    .center-login-card {
        background: rgba(255, 255, 255, 0.22);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        padding: 55px 35px 40px 20px;
        width: 100%;
        max-width: 306px;
        border-radius: 25px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-right: 50px;
    }

    /* Bande wale placeholder ki jagah circular logo holder */
    .avatar-logo-circle {
        width: 110px;
        height: 110px;
        background-color: #ffffff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 30px;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
        padding: 10px;
        overflow: hidden;
    }

    .avatar-img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }

    .login-form {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .input-container {
        width: 100%;
        position: relative;
        display: flex;
        align-items: center;
    }

    .icon {
        position: absolute;
        left: 15px;
        font-size: 1.1rem;
        color: #333;
    }

    .form-input {
        width: 100%;
        padding: 12px 15px 12px 45px;
        border-radius: 25px;
        border: 1px solid rgba(0, 0, 0, 0.25);
        background: rgba(255, 255, 255, 0.9);
        font-size: 0.95rem;
        outline: none;
        color: #000;
        transition: all 0.3s ease;
    }

        .form-input:focus {
            background: #ffffff;
            border-color: #ff8c00;
            box-shadow: 0 0 8px rgba(255, 140, 0, 0.4);
        }

    .options-container {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.85rem;
        color: #000;
        font-weight: 600;
        padding: 0 5px;
    }

    .remember-me {
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
    }

    .forgot-pwd {
        color: #002699;
        text-decoration: none;
    }

        .forgot-pwd:hover {
            text-decoration: underline;
        }

    /* Orange Sign In Button */
    .signin-btn {
        width: 100%;
        padding: 12px;
        border-radius: 25px;
        background: linear-gradient(135deg, #ffa500, #ff7f00);
        border: none;
        color: white;
        font-size: 1rem;
        font-weight: bold;
        letter-spacing: 1px;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(255, 127, 0, 0.3);
        transition: all 0.2s ease-in-out;
        margin-top: 5px;
    }

        .signin-btn:hover {
            background: linear-gradient(135deg, #e69500, #e67300);
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(255, 127, 0, 0.4);
        }

    /* Error / Success Alerts */
    .alert-message {
        position: fixed;
        top: 20px;
        right: 20px;
        color: #ffffff;
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 500;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-width: 250px;
    }

        .alert-message p {
            margin: 0;
        }

        .alert-message.fade-out {
            opacity: 0;
            transform: translateY(-20px);
        }

    .error {
        background-color: #d32f2f;
    }

    .success {
        background-color: #4CAF50;
    }

    .close-btn {
        background: transparent;
        border: none;
        color: #fff;
        font-size: 20px;
        cursor: pointer;
        margin-left: 10px;
    }
</style>

<script>
    function closeAlertMessage() {
        const alertMessage = document.getElementById('alertMessage');
        if (alertMessage) {
            alertMessage.classList.add('fade-out');
            setTimeout(() => alertMessage.style.display = 'none', 500);
        }
    }
    setTimeout(closeAlertMessage, 2500);
</script>