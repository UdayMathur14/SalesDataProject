@model SalesDataProject.Models.UploadResultViewModel
@{
    ViewData["Title"] = "View Records";
    var canAccessUserManagement = ViewContext.HttpContext.Session.GetString("CanAccessUserManagement");
}
<div class="container mt-4">
    <div class="header d-flex justify-content-between align-items-center mb-3 text-white rounded-4 p-4" style="background-color:cadetblue;border-radius:0.7rem">
        <h4 class="mb-0"><i class="bi bi-clipboard-check me-2"></i> Lead Data Management</h4>
        <div class="buttons d-flex gap-2">
            <form asp-action="UploadSalesData" method="post" enctype="multipart/form-data" id="uploadForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="categorySelectHidden" name="selectedCategory" value="" />
                <input type="file" id="fileUpload" name="file" class="form-control-file d-none" required />
                <button type="button" id="uploadButton" class="btn btn-outline-light btn-sm"><i class="bi bi-upload me-1"></i> Upload</button>
            </form>
            <button type="button" class="btn btn-outline-light btn-sm shadow-sm" id="downloadBtn">
                <i class="bi bi-download me-1"></i> Template
            </button>
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-light btn-sm shadow-sm"><i class="bi bi-arrow-left me-1"></i> Back</a>
        </div>
                        
    </div>

    <div class="card shadow-lg p-4 mb-5 border-left-info border-3" style="background-color:lightcyan">
        <h5 class="mb-3 fw-semibold"><i class="bi bi-search me-2"></i> Filter Lead Data</h5>
        <form asp-action="ViewRecord" method="post" id="viewRecordForm">
            @Html.AntiForgeryToken()
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label for="FromDate" class="form-label text-secondary small"><i class="bi bi-calendar2-minus me-1"></i> From :</label>
                    <input asp-for="FromDate" class="form-control form-control-sm shadow-sm" type="date" />
                </div>
                <div class="col-md-3">
                    <label for="ToDate" class="form-label text-secondary small"><i class="bi bi-calendar2-plus me-1"></i> To :</label>
                    <input asp-for="ToDate" class="form-control form-control-sm shadow-sm" type="date" />
                </div>
                <div class="col-md-3">
                    <label for="RecordType" class="form-label text-secondary small"><i class="bi bi-list-ul me-1"></i> Type :</label>
                    <select asp-for="RecordType" class="form-select form-control-sm shadow-sm">
                        <option value="">-- Select --</option>
                        <option value="Blocked">Blocked</option>
                        <option value="Clean">Clean</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="Category" class="form-label text-secondary small"><i class="bi bi-bookmark me-1"></i> Category :</label>
                    <select asp-for="Category" class="form-select form-control-sm shadow-sm">
                        <option value="">-- Select --</option>
                        <option value="UNIVERSITY">University</option>
                        <option value="CORPORATE">Corporate</option>
                        <option value="LAWFIRM">Law Firm</option>
                        <option value="PCT">PCT</option>
                        <option value="INDIVIDUAL">Individual</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="Event" class="form-label text-secondary small"><i class="bi bi-calendar-event me-1"></i> Event:</label>
                    <select asp-for="Event" asp-items="ViewBag.EventNames" class="form-select form-control-sm shadow-sm">
                        <option value="">-- Select --</option>
                    </select>
                </div>

                @* User filter: show only to users with management access *@
                @if (canAccessUserManagement == "True")
                {
                <div class="col-md-3">
                    <label for="UserName" class="form-label text-secondary small"><i class="bi bi-person me-1"></i> User :</label>
                    <select asp-for="UserName" asp-items="ViewBag.Users" class="form-select form-control-sm shadow-sm">
                        <option value="">-- My Data --</option>
                        <option value="__ALL__">-- All Users --</option>
                    </select>
                </div>
                }

                <div class="col-md-2">
                    <label for="PageSize" class="form-label text-secondary small"><i class="bi bi-list-columns-reverse me-1"></i> Rows :</label>
                    <select asp-for="PageSize" class="form-select form-control-sm shadow-sm" id="pageSizeSelect">
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="200">200</option>
                        <option value="500">500</option>
                        <option value="0">All</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2 align-items-end" style="border-radius:0.7rem; display:flex; align-items:end;">
                    <input type="hidden" asp-for="CleanPage" />
                    <input type="hidden" asp-for="BlockedPage" />
                    <button type="submit" class="btn btn-secondary w-100 shadow-sm"><i class="bi bi-filter me-1"></i> Search</button>
                    @if (canAccessUserManagement == "True")
                    {
                        <div class="col-md-3">
                            <button type="submit" formaction="@Url.Action("ExportFilteredExcel", "SalesData")" formmethod="post" class="btn btn-success w-100 shadow-sm">
                                <i class="bi bi-file-earmark-arrow-down me-1"></i> Export
                            </button>
                        </div>
                    }
                <div class="col-md-3 d-flex gap-2 align-items-end">
                    <div class="btn-group btn-group-sm" role="group" aria-label="View toggles">
                        <button type="button" id="showAllBtn" class="btn btn-outline-primary">Show All</button>
                        <button type="button" id="showCleanBtn" class="btn btn-outline-success">Clean</button>
                        <button type="button" id="showBlockedBtn" class="btn btn-outline-warning">Blocked</button>
                    </div>
                </div>
                </div>
                @* <div class="col-md-2 d-flex align-items-end">
                    <button type="button" id="exportBtn" class="btn btn-outline-primary w-100 shadow-sm"><i class="bi bi-file-earmark-spreadsheet me-1"></i> Export</button>
                </div> *@
            </div>
        </form>
    </div>

    <div class="row">
        <div class="mb-2">
            @if (Model.BlockedCustomers != null && Model.BlockedCustomers.Any())
            {
                <div id="blockedSection" class="card shadow-sm border-left-danger border-3">
                    <div class="card-body">
                        <h6 class="card-title text-danger fw-semibold"><i class="bi bi-x-octagon me-2"></i> Blocked Leads</h6>
                        <div class="mb-2">
                            <input type="text" id="filterBlocked" class="form-control form-control-sm" placeholder="Filter blocked leads..." />
                        </div>
                        <div class="table-responsive rounded" style="max-height:720px; overflow:auto; overflow-x: scroll; text-wrap:nowrap;">
                            <table id="blockedTable" class="table table-striped table-hover bg-white mb-0">
                                <thead class="table-danger text-white small">
                                    <tr>
                                        <th>Category</th>
                                        @if (canAccessUserManagement == "True") { <th>Created By</th> }
                                        <th>Company Name</th>
                                        <th>Email</th>
                                        <th>Contact Number</th>
                                        <th>Blocked On</th>
                                        <th>Locked By</th>
                                        @if (canAccessUserManagement == "True")
                                        {
                                            <th>Blocked Reason</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody class="small">
                                    @foreach (var customer in Model.BlockedCustomers)
                                    {
                                        <tr>
                                            <td>@customer?.CATEGORY</td>
                                            @if (canAccessUserManagement == "True") { <td>@customer?.CREATED_BY</td> }
                                            <td>@customer?.COMPANY_NAME</td>
                                            <td>@customer?.CUSTOMER_EMAIL</td>
                                            <td>@customer?.CUSTOMER_CONTACT_NUMBER1</td>
                                            <td>@(customer?.CREATED_ON != null ? customer?.CREATED_ON.Value.ToString("yyyy-MM-dd") : "")</td>
                                            <td>@customer?.BLOCKED_BY</td>
                                            @if (canAccessUserManagement == "True")
                                            {
                                                <td>@customer?.BLOCK_REASON</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <div class="small text-muted">Total: @Model.BlockedTotalCount</div>
                            <div>
                                @{ 
                                    var blockedTotalPages = (Model.PageSize > 0) ? (int)System.Math.Ceiling((double)Model.BlockedTotalCount / Model.PageSize) : 1; 
                                    var showBlockedPager = Model.PageSize > 0 && blockedTotalPages > 1;
                                }
                                @if (showBlockedPager)
                                {
                                    var start = System.Math.Max(1, Model.BlockedPage - 4);
                                    var end = System.Math.Min(blockedTotalPages, start + 9);
                                    if (end - start < 9) { start = System.Math.Max(1, end - 9); }
                                    <nav aria-label="blocked-pagination">
                                        <ul class="pagination mb-0">
                                            <li class="page-item @(Model.BlockedPage <= 1 ? "disabled" : "")">
                                                <button type="button" class="page-link" onclick="goToPage('blocked', @(Model.BlockedPage - 1))">Prev</button>
                                            </li>
                                            @for (int p = start; p <= end; p++)
                                            {
                                                var active = p == Model.BlockedPage ? "active" : "";
                                                <li class="page-item @active"><button type="button" class="page-link" onclick="goToPage('blocked', @p)">@p</button></li>
                                            }
                                            <li class="page-item @(Model.BlockedPage >= blockedTotalPages ? "disabled" : "")">
                                                <button type="button" class="page-link" onclick="goToPage('blocked', @(Model.BlockedPage + 1))">Next</button>
                                            </li>
                                        </ul>
                                    </nav>
                                }
                                else
                                {
                                    <div class="small text-muted">Showing all</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (Model.BlockedCustomers != null)
            {
                <div class="alert alert-light shadow-sm border-left-danger border-3" role="alert">
                    <i class="bi bi-x-octagon me-2"></i> No blocked leads found.
                </div>
            }
        </div>

        <div class="mt-2 mb-4">
            @if (Model.CleanCustomers != null && Model.CleanCustomers.Any())
            {
                <div id="cleanSection" class="card shadow-sm border-left-success border-3">
                    <div class="card-body">
                        <h6 class="card-title text-success fw-semibold"><i class="bi bi-check-circle me-2"></i> Clean Leads</h6>
                        <div class="mb-2">
                            <input type="text" id="filterClean" class="form-control form-control-sm" placeholder="Filter clean leads..." />
                        </div>
                        <div class="table-responsive rounded" style="max-height:720px; overflow:auto; overflow-x: scroll; text-wrap:nowrap;">
                            <table id="cleanTable" class="table table-striped table-hover bg-white mb-0">
                                <thead class="table-success text-white small">
                                    <tr>
                                        <th>Category</th>
                                        @if (canAccessUserManagement == "True") { <th>Created By</th> }
                                        <th>Company Name</th>
                                        <th>Email</th>
                                        <th>Contact Number</th>
                                        <th>Created On</th>
                                    </tr>
                                </thead>
                                <tbody class="small">
                                    @foreach (var customer in Model.CleanCustomers)
                                    {
                                        <tr>
                                            <td>@customer?.CATEGORY</td>
                                            @if (canAccessUserManagement == "True") { <td>@customer?.CREATED_BY</td> }
                                            <td>@customer?.COMPANY_NAME</td>
                                            <td>@customer?.CUSTOMER_EMAIL</td>
                                            <td>@customer?.CUSTOMER_CONTACT_NUMBER1</td>
                                            <td>@(customer?.CREATED_ON != null ? customer?.CREATED_ON.Value.ToString("yyyy-MM-dd") : "")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <div class="small text-muted">Total: @Model.CleanTotalCount</div>
                        <div>
                            @{ 
                                var cleanTotalPages = (Model.PageSize > 0) ? (int)System.Math.Ceiling((double)Model.CleanTotalCount / Model.PageSize) : 1; 
                                var showCleanPager = Model.PageSize > 0 && cleanTotalPages > 1;
                            }
                            @if (showCleanPager)
                            {
                                var start = System.Math.Max(1, Model.CleanPage - 4);
                                var end = System.Math.Min(cleanTotalPages, start + 9);
                                if (end - start < 9) { start = System.Math.Max(1, end - 9); }
                                <nav aria-label="clean-pagination">
                                    <ul class="pagination mb-0">
                                        <li class="page-item @(Model.CleanPage <= 1 ? "disabled" : "")">
                                            <button type="button" class="page-link" onclick="goToPage('clean', @(Model.CleanPage - 1))">Prev</button>
                                        </li>
                                        @for (int p = start; p <= end; p++)
                                        {
                                            var active = p == Model.CleanPage ? "active" : "";
                                            <li class="page-item @active"><button type="button" class="page-link" onclick="goToPage('clean', @p)">@p</button></li>
                                        }
                                        <li class="page-item @(Model.CleanPage >= cleanTotalPages ? "disabled" : "")">
                                            <button type="button" class="page-link" onclick="goToPage('clean', @(Model.CleanPage + 1))">Next</button>
                                        </li>
                                    </ul>
                                </nav>
                            }
                            else
                            {
                                <div class="small text-muted">Showing all</div>
                            }
                        </div>
                    </div>
                    </div>
                </div>
            }
            else if (Model.CleanCustomers != null)
            {
                <div class="alert alert-light shadow-sm border-left-success border-3" role="alert">
                    <i class="bi bi-check-circle me-2"></i> No clean leads found.
                </div>
            }
        </div>
    </div>

    <div class="card shadow-lg p-4 mb-4 border-left-warning border-3" style="background-color:lightgoldenrodyellow">
        <h5 class="mb-3 fw-semibold"><i class="bi bi-upload me-2"></i> Upload Event Contacts</h5>
        <form asp-action="UploadSalesDataEvent" method="post" enctype="multipart/form-data" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-3">
                <label for="eventName" class="form-label text-secondary small"><i class="bi bi-tag me-1"></i> Event Name:</label>
                <input type="text" class="form-control shadow-sm form-control-sm" id="eventName" name="EventName" required>
            </div>
            <div class="col-md-3">
                <label for="eventDate" class="form-label text-secondary small"><i class="bi bi-calendar me-1"></i> Event Date:</label>
                <input type="date" class="form-control shadow-sm form-control-sm" id="eventDate" name="EventDate" required>
            </div>
            <div class="col-md-3">
                <label for="excelFile" class="form-label text-secondary small"><i class="bi bi-file-earmark-spreadsheet me-1"></i> Excel File:</label>
                <input type="file" class="form-control shadow-sm form-control-sm" id="excelFile" name="file" accept=".xlsx" required>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-warning shadow-sm btn-sm">
                    <i class="bi bi-cloud-upload me-1"></i> Upload
                </button>
                <button id="downloadBtn1" type="submit" class="btn shadow-sm btn-warning btn-sm">
                        <i class="bi bi-file-earmark-arrow-down me-1"></i> Template
                </button>
            </div>
        </form>
    </div>
</div>



<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
 // Optionally, hide buttons if no checkboxes are selected
 $("input[type='checkbox']").change(function () {
 var anyChecked = $("input[type='checkbox']:checked").length >0;
 $(".btn-danger, .btn-success").prop("disabled", !anyChecked);
 });
 });
</script>

<script>
    // Simple client-side table filter for blocked and clean tables
    (function () {
        function filterTable(inputId, tableSelector) {
            var input = document.getElementById(inputId);
            if (!input) return;
            input.addEventListener('input', function () {
                var filter = input.value.toLowerCase();
                var table = document.querySelector(tableSelector);
                if (!table) return;
                var rows = table.querySelectorAll('tbody tr');
                rows.forEach(function (row) {
                    var text = row.textContent.toLowerCase();
                    row.style.display = text.indexOf(filter) > -1 ? '' : 'none';
                });
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            filterTable('filterBlocked', '#blockedTable');
            filterTable('filterClean', '#cleanTable');
        });
    })();
</script>

<script>
    function goToPage(type, page) {
        if (!page || page < 1) return;
        var form = document.getElementById('viewRecordForm');
        if (!form) return;
        var cleanInput = form.querySelector('input[name="CleanPage"]');
        var blockedInput = form.querySelector('input[name="BlockedPage"]');
        if (type === 'clean') {
            if (cleanInput) cleanInput.value = page;
            if (blockedInput) blockedInput.value = 1; // reset other pager
        } else if (type === 'blocked') {
            if (blockedInput) blockedInput.value = page;
            if (cleanInput) cleanInput.value = 1; // reset other pager
        }
        form.submit();
    }
</script>

<script>
    // Ensure normal search resets paging to first page
    (function () {
        var form = document.getElementById('viewRecordForm');
        if (!form) return;
        form.addEventListener('submit', function (e) {
            try {
                var cleanInput = form.querySelector('input[name="CleanPage"]');
                var blockedInput = form.querySelector('input[name="BlockedPage"]');
                if (cleanInput) cleanInput.value = 1;
                if (blockedInput) blockedInput.value = 1;
            } catch (ex) {
                console.error('Error resetting paging inputs', ex);
            }
        });
    })();
</script>

<script>
    // Toggle visibility between Clean and Blocked sections
    document.addEventListener('DOMContentLoaded', function () {
        var blocked = document.getElementById('blockedSection');
        var clean = document.getElementById('cleanSection');
        var btnAll = document.getElementById('showAllBtn');
        var btnClean = document.getElementById('showCleanBtn');
        var btnBlocked = document.getElementById('showBlockedBtn');

        function setView(mode) {
            if (mode === 'clean') {
                if (clean) clean.style.display = '';
                if (blocked) blocked.style.display = 'none';
            } else if (mode === 'blocked') {
                if (clean) clean.style.display = 'none';
                if (blocked) blocked.style.display = '';
            } else {
                if (clean) clean.style.display = '';
                if (blocked) blocked.style.display = '';
            }
            try { localStorage.setItem('sales_view', mode); } catch (e) {}
        }

        if (btnAll) btnAll.addEventListener('click', function () { setView('all'); });
        if (btnClean) btnClean.addEventListener('click', function () { setView('clean'); });
        if (btnBlocked) btnBlocked.addEventListener('click', function () { setView('blocked'); });

        // Initialize from previous selection
        try {
            var pref = localStorage.getItem('sales_view') || 'all';
            setView(pref);
        } catch (e) { setView('all'); }
    });
</script>

<script>
    // Export filtered data: clone current search form inputs and submit to ExportRecords
    document.addEventListener('DOMContentLoaded', function () {
        var exportBtn = document.getElementById('exportBtn');
        var form = document.getElementById('viewRecordForm');
        if (!exportBtn || !form) return;

        exportBtn.addEventListener('click', function () {
            try {
                // Submit the existing form to the ExportRecords endpoint so antiforgery token and all fields are posted naturally
                var originalAction = form.action;
                form.action = '/SalesData/ExportRecords';
                form.submit();
                // No restoration needed because navigation/download will happen; if user stays, page reloads on response.
            } catch (err) {
                console.error('Export failed', err);
                alert('Export failed. Check console for details.');
            }
        });
    });
</script>

<script>
    // When page size changes, reset pages to 1
    (function () {
        var form = document.getElementById('viewRecordForm');
        var pageSizeSelect = document.getElementById('pageSizeSelect');
        if (!form || !pageSizeSelect) return;
        pageSizeSelect.addEventListener('change', function () {
            try {
                var cleanInput = form.querySelector('input[name="CleanPage"]');
                var blockedInput = form.querySelector('input[name="BlockedPage"]');
                if (cleanInput) cleanInput.value = 1;
                if (blockedInput) blockedInput.value = 1;
            } catch (ex) {
                console.error('Error resetting pages on pageSize change', ex);
            }
        });
    })();
</script>


<script>
 document.addEventListener('DOMContentLoaded', function () {
 const uploadButton = document.getElementById('uploadButton');
 const fileUpload = document.getElementById('fileUpload');
 const uploadForm = document.getElementById('uploadForm');

 if (uploadButton && fileUpload && uploadForm) {

 uploadButton.addEventListener('click', function () {
 fileUpload.click();
 });

 fileUpload.addEventListener('change', function () {
 if (fileUpload.files.length >0) {
 showSpinner(); // Show loader
 uploadForm.submit();
 }
 });
 }
 });

 function showSpinner() {
 document.getElementById("spinner-overlay").style.display = "flex";
 }

 function hideSpinner() {
 document.getElementById("spinner-overlay").style.display = "none";
 }

 // Hide the loader when the page is fully loaded (after form submission)
 window.addEventListener('load', function () {
 hideSpinner();
 });
 
 const fileUpload = document.getElementById('fileUpload');
 if (fileUpload) {
 fileUpload.value = '';
 }
</script>


